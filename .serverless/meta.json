    "serviceRawFile": "service: ocs-backend\n\nprovider:\n  name: aws\n  runtime: provided\n  region: us-east-1\n  stage: ${opt:stage, 'dev'}\n  memorySize: 2048\n  timeout: 60  # Adjusted to 30 seconds to comply with HTTP API limits\n  environment:\n    STAGE: ${opt:stage, 'dev'}  # Moved under environment\n\n  ecr:\n    images:\n      ocsbackend:\n        path: ./\n        platform: linux/amd64\n\n  httpApi:\n    cors:\n      allowedOrigins:\n        - '*'\n      allowedHeaders:\n        - Content-Type\n        - Authorization\n      allowedMethods:\n        - OPTIONS\n        - GET\n        - POST\n        - PUT\n        - DELETE\n      allowCredentials: false\n\n  iamRoleStatements:\n    - Effect: Allow\n      Action:\n        - dynamodb:*\n      Resource: \"arn:aws:dynamodb:us-east-1:322521590770:*\"\n    - Effect: Allow\n      Action:\n        - s3:*\n      Resource: \"arn:aws:s3:::*\"\n    - Effect: Allow\n      Action:\n        - polly:SynthesizeSpeech\n      Resource: \"*\"\n    - Effect: Allow\n      Action:\n        - secretsmanager:GetSecretValue\n      Resource: \"arn:aws:secretsmanager:us-west-1:322521590770:*\"\n\nfunctions:\n  app:\n    image:\n      name: ocsbackend\n    events:\n      - httpApi: \n          path: /{any+}\n          method: '*' \n    environment:\n      ENVIRONMENT: \"production\"\n      STAGE: ${opt:stage, 'dev'}\n\n",
